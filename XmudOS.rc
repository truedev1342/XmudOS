IDR_MAINFRAME           ICON    DISCARDABLE     "res\\XmudOS.ico"


IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "檔案(&F)"
    BEGIN
        MENUITEM "離開(&X)",                    ID_APP_EXIT
        MENUITEM "關機(&S)",                    ID_APP_SHUTDOWN
    END
    POPUP "說明(&H)"
    BEGIN
        MENUITEM "關於 XmudOS(&A)...",          ID_APP_ABOUT
    END
END

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 235, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "關於 XmudOS"
FONT 9, "宋体"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "XmudOSbig5 1.38 版",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "版權所有 (C) 2000",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "確定",IDOK,178,7,50,14,WS_GROUP
END


#ifndef _MAC

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,8,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "Comments", "\0"
            VALUE "CompanyName", "Waei\0"
            VALUE "FileDescription", "XmudOS_debug\0"
            VALUE "FileVersion", "1, 0, 0, 1\0"
            VALUE "InternalName", "XmudOS_debug\0"
            VALUE "LegalCopyright", "Copyright c 2000\0"
            VALUE "LegalTrademarks", "\0"
            VALUE "OriginalFilename", "XmudOS_debug.exe\0"
            VALUE "PrivateBuild", "\0"
            VALUE "ProductName", "Waei XmudOS_debug\0"
            VALUE "ProductVersion", "1, 0, 0, 1\0"
            VALUE "SpecialBuild", "\0"
        END
        BLOCK "040404b0"
        BEGIN
            VALUE "Comments", "\0"
            VALUE "CompanyName", "\0"
            VALUE "FileDescription", "XmudOS Microsoft 基本應用程式\0"
            VALUE "FileVersion", "1, 3, 8, 1\0"
            VALUE "InternalName", "XmudOS\0"
            VALUE "LegalCopyright", "版權所有 (C) 2000\0"
            VALUE "LegalTrademarks", "\0"
            VALUE "OriginalFilename", "XmudOS.EXE\0"
            VALUE "PrivateBuild", "\0"
            VALUE "ProductName", "XmudOS 應用程式\0"
            VALUE "ProductVersion", "1, 0, 0, 1\0"
            VALUE "SpecialBuild", "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200, 0x404, 1200
    END
END

#endif

